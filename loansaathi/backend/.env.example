# Sahyogi Loan AI - Backend Environment Configuration

# Google Gemini API Key (Get a free API key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if using OpenAI GPT models)
OPENAI_API_KEY=

# LLM Provider selection: "gemini", "openai", or "fallback_rules"
LLM_PROVIDER=gemini
